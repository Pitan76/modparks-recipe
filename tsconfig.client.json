{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": []
  },
  "include": [
    "src/client/search",
    "src/client/portal",
    "src/client/shared",
    "src/utils/i18n",
    "src/utils/ui",
    "src/generated"
  ]
}
